generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// Add these enum definitions
enum SensorType {
  ULTRASONIC
  INFRARED
  MAGNETIC
  CAMERA
  LIDAR
}

enum Role {
  ADMIN
  CLIENT
}

// Add the Measurement model
model Measurement {
  id          String   @id @default(cuid())
  sensorId    String
  value       Float
  timestamp   DateTime @default(now())
  sensor      Sensor   @relation(fields: [sensorId], references: [id], onDelete: Cascade)
  
  @@index([sensorId, timestamp])
}

model User {
  id          String  @id @default(cuid())
  name        String  @unique
  email       String
  plateNumber String?
  role        Role    @default(CLIENT)
  stays       Stay[]
}

model Stay {
  id            String      @id @default(cuid())
  startHour     DateTime
  endHour       DateTime?
  userId        String
  parkingId     String
  parking       Parking     @relation(fields: [parkingId], references: [id])
  user          User        @relation(fields: [userId], references: [id])
}

model Parking {
  id           String        @id @default(cuid())
  name         String
  location     String
  parkingData  ParkingData[]
  parkingSlots ParkingSlot[]  // Note: Typo here - should be "parkingSlots"?
  stays        Stay[]
}

model ParkingData {
  id             String   @id @default(cuid())
  parkingId      String
  availableSlots Int
  temperature    Decimal
  humidity       Decimal
  date           DateTime
  parking        Parking  @relation(fields: [parkingId], references: [id])
}

model ParkingSlot {
  id           Int     @id @default(autoincrement())
  available    Boolean
  parkingId    String
  parking      Parking @relation(fields: [parkingId], references: [id])
}

model Avenue {
  id String @id
}

model Sensor {
  id          String        @id @default(cuid())
  type        SensorType
  location    String?
  description String?
  status      String?       @default("ACTIVE")
  lastUpdate  DateTime?     @updatedAt
  measurements Measurement[]
}