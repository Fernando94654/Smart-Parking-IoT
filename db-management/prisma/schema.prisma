generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id          String  @id @default(cuid())
  name        String  @unique
  email       String
  plateNumber String?
  role        Role    @default(CLIENT)
  stays       Stay[]
}

model Stay {
  id            String      @id @default(cuid())
  startHour     DateTime
  endHour       DateTime?
  userId        String
  parkingId     String
  parking       Parking     @relation(fields: [parkingId], references: [id])
  user          User        @relation(fields: [userId], references: [id])
}

model Parking {
  id           String        @id @default(cuid())
  name         String
  location     String
  parkingData  ParkingData[]
  parkignSlots ParkingSlot[]
  stays        Stay[]
}

model ParkingData {
  id             String   @id @default(cuid())
  parkingId      String
  availableSlots Int
  temperature    Decimal
  humidity       Decimal
  date           DateTime
  parking        Parking  @relation(fields: [parkingId], references: [id])
}

model ParkingSlot {
  id           Int     @id @default(autoincrement())
  available    Boolean
  parkingId    String
  parking      Parking @relation(fields: [parkingId], references: [id])
}

model Avenue {
  id String @id
}

enum Role {
  ADMIN
  CLIENT
}
